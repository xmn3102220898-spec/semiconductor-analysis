APP_ENV=development
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

PRODUCTION_DATA_FILE=data/production_data.csv
