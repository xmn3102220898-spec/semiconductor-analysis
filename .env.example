APP_ENV=development
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.2
DIAGNOSIS_PROMPT_TEMPLATE=prompts/equipment_diagnosis.md
LLM_MAX_RETRIES=1
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

PRODUCTION_DATA_FILE=data/production_data.csv
PRODUCTION_DB_FILE=database/production.db
DIAGNOSIS_DB_FILE=diagnosis_history.db
KNOWLEDGE_DIR=knowledge_base
KNOWLEDGE_INDEX_DIR=data/rag_index
OUTPUT_DIR=output
ANALYSIS_RULES_FILE=config/analysis_rules.json

TEMPERATURE_LIMIT=100
PRESSURE_LIMIT=120
YIELD_LIMIT=90

RAG_TOP_K=4
RAG_VECTOR_WEIGHT=0.65
RAG_KEYWORD_WEIGHT=0.35
RAG_CHUNK_MAX_CHARS=480
RAG_CHUNK_OVERLAP_CHARS=80
